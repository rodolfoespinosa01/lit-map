{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiT provisional fixed-answer mock schema v1 \u2014 not a confirmed research questionnaire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "submissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "synthetic": {
      "const": true
    },
    "submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "survey_id",
          "response_id",
          "email",
          "submitted_at",
          "updated_at",
          "answers"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "survey_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "response_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,96}$"
          },
          "email": {
            "type": "string",
            "description": "Private synthetic reserved-domain email; trim/lowercase for matching, retain dots and plus tags."
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "[+-]\\d{2}:\\d{2}$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "[+-]\\d{2}:\\d{2}$"
          },
          "answers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "county_geoid",
              "municipality",
              "first_languages",
              "languages",
              "aggregate_permission"
            ],
            "properties": {
              "county_geoid": {
                "type": "string",
                "pattern": "^34[0-9]{3}$"
              },
              "municipality": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^m34[0-9]{8}$"
              },
              "first_languages": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "en",
                    "es",
                    "ko",
                    "pt",
                    "zh",
                    "ar",
                    "hi",
                    "ase"
                  ]
                }
              },
              "languages": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "en",
                    "es",
                    "ko",
                    "pt",
                    "zh",
                    "ar",
                    "hi",
                    "ase"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "uses_language",
                    "speaking",
                    "signing",
                    "home_use",
                    "other_settings",
                    "frequency",
                    "brokering"
                  ],
                  "properties": {
                    "uses_language": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "prefer_not_to_answer"
                      ]
                    },
                    "speaking": {
                      "type": "string",
                      "enum": [
                        "none",
                        "basic",
                        "conversational",
                        "advanced",
                        "fluent",
                        "not_applicable",
                        "prefer_not_to_answer"
                      ]
                    },
                    "signing": {
                      "type": "string",
                      "enum": [
                        "none",
                        "basic",
                        "conversational",
                        "advanced",
                        "fluent",
                        "not_applicable",
                        "prefer_not_to_answer"
                      ]
                    },
                    "home_use": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "prefer_not_to_answer"
                      ]
                    },
                    "other_settings": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "enum": [
                          "work",
                          "education",
                          "friends",
                          "community",
                          "online",
                          "religious",
                          "none",
                          "prefer_not_to_answer"
                        ]
                      }
                    },
                    "frequency": {
                      "type": "string",
                      "enum": [
                        "daily",
                        "weekly",
                        "monthly",
                        "less_often",
                        "never",
                        "prefer_not_to_answer"
                      ]
                    },
                    "brokering": {
                      "type": "string",
                      "enum": [
                        "never",
                        "occasionally",
                        "often",
                        "prefer_not_to_answer"
                      ]
                    }
                  }
                }
              },
              "aggregate_permission": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ]
              }
            }
          }
        }
      }
    }
  }
}
