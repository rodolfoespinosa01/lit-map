<?php

/** Implements hook_schema(). No raw answers or plaintext emails are stored. */
function lit_contribution_schema(): array {
  $text = ['type' => 'varchar', 'length' => 128, 'not null' => TRUE];
  $integer = ['type' => 'int', 'not null' => TRUE, 'default' => 0];
  $schema['lit_contribution_review'] = [
    'description' => 'Private source references and review metadata only.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'survey_id' => $text + ['binary' => TRUE], 'response_id' => $text + ['binary' => TRUE],
      'fingerprint' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'email_digest' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 12, 'not null' => TRUE, 'default' => 'pending'],
      'submitted_day'=>['type'=>'varchar','length'=>10,'not null'=>TRUE,'default'=>''],
      'submitted_epoch'=>['type'=>'int','size'=>'big','not null'=>TRUE,'default'=>0],
      'origin' => ['type'=>'varchar','length'=>12,'not null'=>TRUE,'default'=>'fixture'],
      'publication_permission' => ['type'=>'int','not null'=>TRUE,'default'=>1],
      'source_present' => $integer, 'duplicate_conflict' => $integer, 'duplicate_choice' => $integer,
      'submitted_at' => $text, 'source_updated_at' => $text,
      'imported_at' => $integer, 'synced_at' => $integer, 'reviewed_at' => $integer,
      'reviewer_uid' => $integer, 'published_at' => $integer, 'in_publication' => $integer,
      'reason' => ['type' => 'text', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['source_reference' => ['survey_id', 'response_id']],
    'indexes' => ['duplicate_lookup' => ['survey_id', 'email_digest'], 'submission_date' => ['submitted_epoch']],
  ];
  $schema['lit_contribution_audit'] = [
    'description' => 'Private review trail without source answers or email.',
    'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'review_id' => $integer,
      'action' => $text, 'actor_uid' => $integer, 'occurred_at' => $integer,
      'reason' => ['type' => 'text', 'not null' => TRUE]],
    'primary key' => ['id'], 'indexes' => ['review_id' => ['review_id']],
  ];
  $schema['lit_contribution_publication'] = [
    'description' => 'Atomic pointer to an immutable approved aggregate JSON file.',
    'fields' => ['id' => $integer, 'file_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'published_at' => $integer, 'publisher_uid' => $integer],
    'primary key' => ['id'],
  ];
  $schema['lit_contribution_dataset']=['fields'=>['survey_id'=>$text,'file_hash'=>['type'=>'varchar','length'=>64,'not null'=>TRUE,'default'=>''],'published_at'=>$integer,'publisher_uid'=>$integer,'seeded'=>$integer],'primary key'=>['survey_id']];
  $schema['lit_contribution_access_audit']=['fields'=>['id'=>['type'=>'serial','not null'=>TRUE],'target_uid'=>$integer,'actor_uid'=>$integer,'action'=>$text,'occurred_at'=>$integer],'primary key'=>['id']];
  $schema['lit_contribution_login_token']=['fields'=>['token_hash'=>['type'=>'varchar','length'=>64,'not null'=>TRUE],'uid'=>$integer,'expires'=>$integer,'account_stamp'=>['type'=>'varchar','length'=>64,'not null'=>TRUE]],'primary key'=>['token_hash'],'indexes'=>['uid'=>['uid'],'expires'=>['expires']]];
  $schema['lit_contribution_email_reservation']=['fields'=>['survey_id'=>$text+['binary'=>TRUE],'response_id'=>$text+['binary'=>TRUE],'email_digest'=>['type'=>'varchar','length'=>64,'not null'=>TRUE]],'primary key'=>['survey_id','email_digest'],'unique keys'=>['response'=>['survey_id','response_id']]];
  $schema['lit_contribution_import_state']=['fields'=>['id'=>$integer,'file_hash'=>['type'=>'varchar','length'=>64,'not null'=>TRUE]],'primary key'=>['id']];
  $schema['lit_contribution_import_history']=['fields'=>['id'=>['type'=>'serial','not null'=>TRUE],'actor_uid'=>$integer,'occurred_at'=>$integer,'summary'=>['type'=>'text','size'=>'big','not null'=>TRUE]],'primary key'=>['id']];
  return $schema;
}

/** Preserve exact case-sensitive source identifiers on the initial local host. */
function lit_contribution_update_10001(): void {
  $schema = \Drupal::database()->schema();
  foreach (['survey_id', 'response_id'] as $field) {
    $schema->changeField('lit_contribution_review', $field, $field, ['type'=>'varchar', 'length'=>128, 'not null'=>TRUE, 'binary'=>TRUE]);
  }
}

/** Add scoped demo publication metadata and private account access support. */
function lit_contribution_update_10002(): void {
  $schema=\Drupal::database()->schema();$definitions=lit_contribution_schema();
  foreach(['lit_contribution_dataset','lit_contribution_access_audit','lit_contribution_login_token'] as $table)if(!$schema->tableExists($table))$schema->createTable($table,$definitions[$table]);
}

/** Add upload metadata without modifying any existing decisions or source data. */
function lit_contribution_update_10003(): void {
  $s=\Drupal::database()->schema();$d=lit_contribution_schema();
  foreach(['origin','publication_permission'] as $f)if(!$s->fieldExists('lit_contribution_review',$f))$s->addField('lit_contribution_review',$f,$d['lit_contribution_review']['fields'][$f]);
  foreach(['lit_contribution_import_state','lit_contribution_import_history'] as $t)if(!$s->tableExists($t))$s->createTable($t,$d[$t]);
}

/** Enforce upload email reservations at the database boundary as well as the lock. */
function lit_contribution_update_10004(): void {
  $s=\Drupal::database()->schema();$d=lit_contribution_schema();$t='lit_contribution_email_reservation';
  if(!$s->tableExists($t))$s->createTable($t,$d[$t]);
  foreach(\Drupal::database()->select('lit_contribution_review','r')->fields('r',['survey_id','response_id','email_digest'])->condition('origin','upload')->execute()->fetchAll(\PDO::FETCH_ASSOC) as $r)\Drupal::database()->insert($t)->fields($r)->execute();
}

/** Add submission-date index metadata without changing answers or decisions. */
function lit_contribution_update_10005():void {
 $db=\Drupal::database();$schema=$db->schema();$d=lit_contribution_schema()['lit_contribution_review'];
 foreach(['submitted_day','submitted_epoch'] as $f)if(!$schema->fieldExists('lit_contribution_review',$f))$schema->addField('lit_contribution_review',$f,$d['fields'][$f]);
 foreach($db->select('lit_contribution_review','r')->fields('r',['id','submitted_at'])->execute() as $r){$epoch=$r->submitted_at?strtotime($r->submitted_at):FALSE;$db->update('lit_contribution_review')->fields(['submitted_day'=>$epoch!==FALSE?\Drupal\lit_contribution\Service\SubmissionDates::day($r->submitted_at):'','submitted_epoch'=>$epoch?:0])->condition('id',$r->id)->execute();}
 if(!$schema->indexExists('lit_contribution_review','submission_date'))$schema->addIndex('lit_contribution_review','submission_date',['submitted_epoch'],$d);
}
