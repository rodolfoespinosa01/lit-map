<?php
use Drupal\Core\Entity\EntityInterface;
use Drupal\lit_contribution\Service\OwnerAccess;

/** Guard ownership even through core account forms and entity APIs. */
function lit_contribution_user_presave(EntityInterface $entity): void {
  $owner=(int)\Drupal::state()->get('lit_contribution.owner_uid',0);
  if($owner && (int)$entity->id()===$owner && (!$entity->isActive() || !$entity->hasRole(OwnerAccess::OWNER_ROLE)))throw new \RuntimeException('The sole application owner must remain active and retain ownership. Use the documented server recovery procedure.');
  if($entity->hasRole(OwnerAccess::OWNER_ROLE) && (int)$entity->id()!==$owner)throw new \RuntimeException('Ownership can only be bootstrapped server-side for one account.');
}
function lit_contribution_user_predelete(EntityInterface $entity): void {
  if((int)$entity->id()===(int)\Drupal::state()->get('lit_contribution.owner_uid',0))throw new \RuntimeException('The sole application owner cannot be deleted.');
}
function lit_contribution_user_update(EntityInterface $entity): void {
  $old=$entity->original??NULL;
  if(!$entity->isActive() || ($old && ($old->getRoles()!==$entity->getRoles() || $old->getEmail()!==$entity->getEmail() || $old->getPassword()!==$entity->getPassword())))\Drupal::service('lit_contribution.owner')->revoke((int)$entity->id());
}
function lit_contribution_user_role_predelete(EntityInterface $entity): void {
  if($entity->id()===OwnerAccess::OWNER_ROLE && \Drupal::state()->get('lit_contribution.owner_uid'))throw new \RuntimeException('The application owner role cannot be deleted while assigned.');
}
/** Old authentication mail is explicitly suppressed; shared Drupal mail stays installed. */
function lit_contribution_mail($key,&$message,$params): void {
  if($key==='signin')$message['send']=FALSE;
}
function lit_contribution_cron(): void { \Drupal::service('lit_contribution.export_store')->cleanup();
  \Drupal::database()->delete('lit_contribution_login_token')->condition('expires',time(),'<')->execute();
}

/** Scope credential restrictions to LiT-managed accounts; preserve UID 1 and other users. */
function lit_contribution_managed_credentials(\Drupal\user\UserInterface $u): bool {
  return (int)$u->id()!==1 && ((int)$u->id()===(int)\Drupal::state()->get('lit_contribution.owner_uid',0) || $u->hasRole(OwnerAccess::ADMIN_ROLE));
}
function lit_contribution_mail_alter(array &$message): void {
  if(($message['module']??'')==='user' && ($message['key']??'')==='password_reset' && isset($message['params']['account']) && lit_contribution_managed_credentials($message['params']['account']))$message['send']=FALSE;
}
function lit_contribution_user_access(\Drupal\Core\Entity\EntityInterface $entity,$operation,\Drupal\Core\Session\AccountInterface $account) {
  $deny=in_array($operation,['update','delete'],TRUE) && (int)$account->id()===(int)$entity->id() && $entity->hasRole(OwnerAccess::ADMIN_ROLE) && !in_array((int)$account->id(),[1,(int)\Drupal::state()->get('lit_contribution.owner_uid',0)],TRUE);
  return ($deny?\Drupal\Core\Access\AccessResult::forbidden():\Drupal\Core\Access\AccessResult::neutral())->addCacheContexts(['user'])->addCacheableDependency($entity);
}

/** Scope local form presentation to this module; retain Drupal Form API controls. */
function lit_contribution_form_alter(&$form,\Drupal\Core\Form\FormStateInterface $form_state,$form_id): void {
  if(str_starts_with($form_id,'lit_contribution_')){$form['#attributes']['class'][]='lit-contribution-form';$form['#attached']['library'][]='lit_contribution/admin';}
}

/** Account navigation also appears on access-denied pages, without opening access. */
function lit_contribution_page_top(array &$page_top): void {
  if(!lit_contribution_is_flow())return;
  $account=\Drupal::currentUser();
  $nav=['#type'=>'container','#attributes'=>['class'=>['lit-account-nav'],'aria-label'=>'LiT account navigation'],'#cache'=>['contexts'=>['user'],'max-age'=>0],'#attached'=>['library'=>['lit_contribution/admin']]];
  $nav['map']=['#type'=>'link','#title'=>'Language map','#url'=>\Drupal\Core\Url::fromRoute('lit_contribution.map')];
  if($account->isAuthenticated()){
    $nav['identity']=['#plain_text'=>'Signed in as '.$account->getAccountName()];
    if(\Drupal::service('lit_contribution.owner')->isOwner())$nav['dashboard']=['#type'=>'link','#title'=>'Owner dashboard','#url'=>\Drupal\Core\Url::fromRoute('lit_contribution.dashboard')];
    elseif($account->hasPermission('review lit contributions'))$nav['pending']=['#type'=>'link','#title'=>'Pending reviews','#url'=>\Drupal\Core\Url::fromRoute('lit_contribution.pending')];
    $nav['logout']=['#type'=>'link','#title'=>'Log out','#url'=>\Drupal\Core\Url::fromRoute('user.logout.confirm')];
    $nav['signin']=['#type'=>'link','#title'=>'LiT login choices','#url'=>\Drupal\Core\Url::fromRoute('lit_contribution.signin')];
  }else $nav['signin']=['#type'=>'link','#title'=>'LiT login choices','#url'=>\Drupal\Core\Url::fromRoute('lit_contribution.signin')];
  $page_top['lit_account']=$nav;
}

/** Do not replace the receiving site's normal account pages or menus. */
function lit_contribution_is_flow(): bool {
  $path=\Drupal::request()->getPathInfo();
  return str_starts_with((string)\Drupal::routeMatch()->getRouteName(),'lit_contribution.') || preg_match('~^/(lit/sign-in|lit-map/contribution-preview|admin/lit|admin/people/lit-administrators|admin/(content|config)/lit-contributions)(/|$)~',$path)===1;
}
function lit_contribution_block_access(\Drupal\block\BlockInterface $block,$operation,\Drupal\Core\Session\AccountInterface $account) {
  $result=$operation==='view' && lit_contribution_is_flow() && $block->getPluginId()==='system_menu_block:account'
    ? \Drupal\Core\Access\AccessResult::forbidden() : \Drupal\Core\Access\AccessResult::neutral();
  return $result->addCacheContexts(['url.path','route']);
}

