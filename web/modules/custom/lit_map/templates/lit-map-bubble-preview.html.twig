<section id="{{ instance_id }}" class="lit-bubbles{% if dataset_map %} lit-bubbles--dataset{% endif %}" aria-label="{{ heading ?: 'New Jersey language survey' }}">
  <h2>{{ heading ?: 'New Jersey language survey' }}{% if not heading and not dataset_map %} · interaction preview{% endif %}</h2>
  {{ intro }}
  <p class="lit-bubbles__notice">{% if synthetic %}<strong>Synthetic demonstration data.</strong>{% else %}<strong>Survey response aggregates.</strong>{% endif %} {% if empty_publication %}No data available. Geographic boundaries remain available for exploration.{% elseif dataset_map %}This map displays the supplied dataset. Values mean survey responses, not population or unique people.{% else %}Every count is fabricated for testing. Values mean survey responses, not population, language prevalence, or unique people.{% endif %}</p>
  {% if dataset_map %}
    <p data-publication-date>Public data updated: {{ publication_date ?: 'No dataset supplied' }}{% if publication_date %} (UTC date){% endif %}.</p>

  {% endif %}
  {% if available %}
    {% if dataset_map %}
      <p data-opening-status role="status"></p>
      {% if invitation_url %}<p><a class="lit-bubbles__invitation" data-invitation href="{{ invitation_url }}" rel="noopener noreferrer">Share your language experience</a> — The survey opens on Qualtrics.</p>{% endif %}
      <details class="lit-bubbles__filters" data-filter-disclosure><summary>Change languages, places and submission dates</summary>
    <fieldset class="lit-bubbles__dates"><legend>Submission dates · America/New_York</legend>
      <label>From <input type="date" data-date-from></label>
      <label>Through <input type="date" data-date-through></label>
      <button type="button" data-date-preset="all">All time</button><button type="button" data-date-preset="30">Last 30 days</button><button type="button" data-date-preset="90">Last 90 days</button><button type="button" data-date-preset="year">This year</button>
      <p data-date-status role="status"></p>
    </fieldset>

    {% endif %}
    <div class="lit-bubbles__controls">
      <fieldset data-languages><legend>Compare languages</legend></fieldset>
      {% if not dataset_map %}<label>Numbers and bubble size: active language <select data-active></select></label>{% endif %}
      <label>County <select data-county><option value="">Choose a county</option></select></label>
      <label><input type="checkbox" data-breakdown disabled> Show towns/cities</label>
      <label>Search NJ municipality or community <input type="search" data-place-search maxlength="100" aria-describedby="{{ instance_id }}-place-help"></label>
      <p id="{{ instance_id }}-place-help">Search within the selected county, or clear County to search New Jersey. Community matches select their municipality; counts describe the entire municipality.</p>
      <div data-place-results aria-live="polite"></div>
      <label>Town/city <select data-municipality disabled><option value="">All towns/cities</option></select></label>
    </div>
    {% if dataset_map %}</details>{% endif %}
    {% set navigation %}
    <div class="lit-bubbles__toolbar" aria-label="Map navigation">
      <button type="button" data-action="nj">Back to New Jersey</button>
      <button type="button" data-action="usa">USA overview</button>
      <button type="button" data-action="in" aria-label="Zoom in">Zoom +</button>
      <button type="button" data-action="out" aria-label="Zoom out">Zoom −</button>
      <button type="button" data-action="fit">Fit current view</button>
      <button type="button" data-action="reset">{% if dataset_map %}Reset opening preset{% else %}Reset selections{% endif %}</button>
      {% if dataset_map %}<button type="button" data-action="clear">Clear languages</button>{% endif %}
    </div>
    {% endset %}
    {% if not dataset_map %}{{ navigation }}{% endif %}
    <div class="lit-bubbles__layout">
      <div>
        <h3 data-heading>New Jersey</h3>
        <div class="lit-bubbles__stage" tabindex="0" role="group" aria-label="Interactive map. Arrow keys pan, plus and minus zoom, Home fits view. County and town selectors provide equivalent navigation.">
          <div data-nj>{{ svg }}</div>
          <div data-usa hidden></div>
          <svg class="lit-bubbles__overlay" aria-label="Survey response bubbles"></svg>
        </div>
        {% if dataset_map %}{{ navigation }}<p data-coverage></p><p>Qualtrics collects responses externally. This map displays a validated file snapshot.</p>{% endif %}
        {% if dataset_map %}    <details><summary>Questionnaire aggregates · development disclosure rules</summary><div data-question-panels aria-live="polite"></div></details>
{% endif %}
        <p data-map-status role="status"></p>
        <div class="lit-bubbles__tooltip-dock">
          <small>Hover or focus a place for counts here. Click/tap for the panel. Escape dismisses the tooltip.</small>
          <p id="{{ instance_id }}-tooltip" data-tooltip role="tooltip" hidden></p>
          <button type="button" data-tooltip-dismiss hidden>Dismiss tooltip</button>
        </div>
        <p class="lit-bubbles__callout" data-callout aria-live="polite">Select languages to show bubbles. Select a county at any time.</p>
        <div class="lit-bubbles__toolbar" aria-label="Pan controls">
          <button type="button" data-action="left" aria-label="Pan left">←</button><button type="button" data-action="up" aria-label="Pan up">↑</button><button type="button" data-action="down" aria-label="Pan down">↓</button><button type="button" data-action="right" aria-label="Pan right">→</button>
          <label><input type="checkbox" data-touch> Move map with touch (turn off to scroll here)</label>
          <label><input type="checkbox" data-motion> Gentle motion</label>
        </div>
        <p data-motion-help></p>
        <p class="lit-bubbles__source">Boundaries: <a href="https://www.census.gov/geographies/mapping-files/2025/geo/carto-boundary-file.html">U.S. Census Bureau, 2025 cartographic boundary files</a>. Generalized geometry; zoom adds no geographic detail.</p>
        <div class="lit-bubbles__legend">
          <strong>Reading the bubbles</strong>
          <div data-legend></div>
          <div data-color-legend></div>
          <p>Colors identify selected languages with positive counts in this place. Equal segments are categories, not population shares. More than six matches use a neutral disc marked “+”; every matching language is named in the callout and results. {% if dataset_map %}Numbers and size represent survey responses reporting ANY selected language, counted once per area. Individual language counts overlap. An explicit combined zero is hollow; missing data is not zero.{% else %}Size still represents only the active language. An active-language zero remains hollow, with a categorical outline if other selected languages have positive counts. An unrecorded active language has no bubble; other language results remain in the panel.{% endif %}</p>
          <p>{% if dataset_map %}Area represents the combined distinct-response count for ANY selected language.{% else %}Area represents only the active language.{% endif %} Small positive bubbles have a {% if dataset_map %}14{% else %}5{% endif %} px minimum radius; large bubbles cap at {% if dataset_map %}38{% else %}32{% endif %} px. These caps alter visual scaling. Hollow rings mean an explicit zero; no bubble means no data, not zero. Touch targets are at least 44 px.</p>
          <p>Geographic anchors stay inside their boundaries. Bubbles may extend across borders.{% if dataset_map %} Crowded bubbles move a limited distance from their anchors, shown by a small dot and connector. Counts stay inside the bubbles where possible; named callouts are a last resort for crowded labels.{% endif %} Select a bubble or a result below to bring it forward and show its name and exact count. Zoom in for separation. The results list provides every value.</p>
          <p>Drag to pan after zooming; use buttons or arrow keys for precise movement. Page scrolling remains available by default. Enable touch movement only when you want to drag the map on a phone.</p>
        </div>
      </div>
      <aside class="lit-bubbles__panel" aria-label="Survey response comparisons">
        <h3 data-results-heading>Survey responses</h3>
        <p data-summary role="status"></p>
        <div data-results></div>
        <template data-resource-templates>{% for resource in resources %}{{ resource.card }}{% endfor %}</template>
      </aside>
    </div>
    <noscript><p>Enable JavaScript to filter survey counts. These boundaries alone do not represent counts.</p>{{ fallback }}{% for resource in resources %}{{ resource.card }}{% endfor %}</noscript>
  {% else %}
    <p role="status">The demonstration data is temporarily unavailable. Please try again later.</p>
  {% endif %}
</section>
